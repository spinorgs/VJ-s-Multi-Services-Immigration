# Copy to .env.vjs-nationwide-services inside functions/; real files are gitignored.
# Recipient and sender are server-only settings; do not set these in public site-config.js.
INQUIRY_TO_EMAIL=owner@example.com
INQUIRY_FROM_EMAIL=appointments@your-verified-domain.example
INQUIRY_ALLOWED_ORIGINS=https://vjsmultiservices.com,https://www.vjsmultiservices.com,https://vjs-nationwide-services.web.app
# Secrets belong in Secret Manager: RESEND_API_KEY, TURNSTILE_SECRET_KEY, RATE_LIMIT_SALT.
